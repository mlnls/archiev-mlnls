# 로컬 개발용 예시. 실제 값은 커밋하지 않습니다.
# 운영 값은 서버의 /srv/archiev/.env 에만 있습니다.

# API
PORT=4000
DB_FILE=.data/archiev.db
UPLOAD_DIR=.data/uploads
SESSION_SECRET=
# node scripts/hash-password.mjs '<비밀번호>' 결과
ADMIN_PASSWORD_HASH=
# Mac 워커 인증용 임의 문자열 (openssl rand -hex 32)
WORKER_TOKEN=
# 블로그 캐시 무효화용 임의 문자열 (openssl rand -hex 32)
REVALIDATE_SECRET=
BLOG_INTERNAL_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
COOKIE_DOMAIN=
BATCH_CRON=0 8 * * *

# 수집
SCRAPE_MAX_PAGES=5
SCRAPE_DELAY_MS=800
SARAMIN_ACCESS_KEY=
ROCKETPUNCH_API_KEY=

# 블로그
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# 비워 두면 해당 도구를 불러오지 않습니다. 운영 값은 GitHub Actions Variables에 둡니다.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_AMPLITUDE_KEY=
NEXT_PUBLIC_GSC_TOKEN=

# 워커 (Mac)
API_URL=https://employ.mlnl.site/api
FIGMA_FILE_KEY=
