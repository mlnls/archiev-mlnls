# >>> archiev-mlnls (이 블록은 archiev-mlnls/deploy/Caddyfile.mlnl 에서 관리합니다. __SITE_DOMAIN__ 은 설치할 때 .env의 SITE_DOMAIN으로 바뀝니다)
(mlnl_common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

__SITE_DOMAIN__ {
	import mlnl_common
	reverse_proxy mlnl-cv:80
}

www.__SITE_DOMAIN__ {
	redir https://__SITE_DOMAIN__{uri} permanent
}

blog.__SITE_DOMAIN__ {
	import mlnl_common
	handle_path /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy mlnl-api:4000
	}
	handle {
		reverse_proxy mlnl-blog:3000
	}
}

# employ(채용 레이더)와 archive(보관함)는 공개하지 않고 Tailscale serve로만 엽니다
# <<< archiev-mlnls
