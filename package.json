{
  "name": "archiev-mlnls",
  "private": true,
  "description": "mlnl.site, blog.mlnl.site, employ.mlnl.site monorepo",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "batch": "pnpm --filter @archiev/scraper batch",
    "batch:dry": "pnpm --filter @archiev/scraper batch --dry-run",
    "worker": "pnpm --filter @archiev/employ-worker start",
    "worker:install": "bash apps/employ-worker/install-launchd.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
