{
  "name": "@archiev/archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3003",
    "dev:server": "tsx watch --env-file-if-exists=../../.env server/main.ts",
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "hono": "^4.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
